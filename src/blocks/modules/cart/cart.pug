.button-cart.js-cart-toggle
    +svg("cart-svgrepo-com")

.cart
    .cart__close
        button.js-cart-close-mobile
            +svg("close-icon")

    .cart__top
        h3 DETO L790 стандартная

    form.cart__bottom(data-cart data-default-price="33900")
        .cart__content
            .cart__content-head
                .cart__slider
                    .swiper.mySwiper2(style='--swiper-navigation-color: #fff; --swiper-pagination-color: #fff')
                        .swiper-wrapper
                            .swiper-slide
                                img(src='img/slide-1.jpg' data-fancybox data-src="img/slide-1.jpg")
                            .swiper-slide
                                img(src='img/slide-2.jpg' data-fancybox data-src="img/slide-2.jpg")
                            .swiper-slide
                                img(src='img/slide-3.jpg' data-fancybox data-src="img/slide-3.jpg")
                            .swiper-slide
                                img(src='img/slide-4.jpg' data-fancybox data-src="img/slide-4.jpg")
                            .swiper-slide
                                img(src='img/slide-5.jpg' data-fancybox data-src="img/slide-5.jpg")
                            .swiper-slide
                                img(src='img/slide-6.jpg' data-fancybox data-src="img/slide-6.jpg")
                            .swiper-slide
                                img(src='img/slide-7.jpg' data-fancybox data-src="img/slide-7.jpg")
                            .swiper-slide
                                img(src='img/slide-8.jpg' data-fancybox data-src="img/slide-8.jpg")
                            .swiper-slide
                                img(src='img/slide-10.jpg' data-fancybox data-src="img/slide-10.jpg")
                            .swiper-slide
                                img(src='img/slide-11.jpg' data-fancybox data-src="img/slide-11.jpg")
                            .swiper-slide
                                img(src='img/slide-12.jpg' data-fancybox data-src="img/slide-12.jpg")
                            .swiper-slide
                                img(src='img/slide-13.jpg' data-fancybox data-src="img/slide-13.jpg")
                            .swiper-slide
                                img(src='img/slide-14.jpg' data-fancybox data-src="img/slide-14.jpg")


                    .cart__detail
                        .cart__check
                            +svg("check-big")
                            span есть в наличии

                        h3
                            input(name="price" type="hidden" value="33900" data-total-price-input)
                            span(data-total-price)
                                | 33 900
                            | &nbsp;₽

                        em кол-во:
                        .incdec
                            button(type="button" data-minus).incdec__minus -
                            input(data-input data-form-incdec type="number" name="incdec" value="1")
                            button(type="button" data-plus).incdec__plus +

                        .cart__detail-footer
                            button.cart__detail-btn
                                span КУПИТЬ
                            a(href="#") В ИЗБРАННОЕ

                .cart__detail-bottom
                    .cart__checks
                        ul
                            li
                                label(for="series-l")
                                    em Установка под ключ
                                        br
                                        | серия L
                                    input(data-form-check type="checkbox" id="series-l" value="7000" name="cart-checks")
                                    span + 7 000 ₽

                            li
                                label(for="termo")
                                    em Термостатический
                                        br
                                        | смеситель
                                    input(data-form-check type="checkbox" id="termo" value="9000" name="termo")
                                    span + 9 000 ₽

                            li
                                label(for="proggenerator")
                                    em Парогенератор
                                    input(data-form-check type="checkbox" id="proggenerator" value="21000" name="proggenerator")
                                    span + 21 000 ₽

                    .cart__links
                        a(href="#") ДОБАВИТЬ В СПИСОК СРАВНЕНИЯ
                        a(href="#").orange РАССЧИТАТЬ СТОИМОСТЬ ДОСТАВКИ
                        a(href="#").orange ОФОРМИТЬ В РАССРОЧКУ ИЛИ В КРЕДИТ

                        .cart__stars
                            div
                                +svg("star")
                                +svg("star")
                                +svg("star")
                                +svg("star")
                                +svg("star")

                            span отзывы о товаре (9)


        .cart__thumbs
            .swiper-button-prev
                img(src="img/prev.svg" alt="prev")

            //Thumbs
            .swiper.mySwiper(thumbsslider='')
                .swiper-wrapper
                    .swiper-slide
                        img(src='img/slide-1.jpg')
                    .swiper-slide
                        img(src='img/slide-2.jpg')
                    .swiper-slide
                        img(src='img/slide-3.jpg')
                    .swiper-slide
                        img(src='img/slide-4.jpg')
                    .swiper-slide
                        img(src='img/slide-5.jpg')
                    .swiper-slide
                        img(src='img/slide-6.jpg')
                    .swiper-slide
                        img(src='img/slide-7.jpg')
                    .swiper-slide
                        img(src='img/slide-8.jpg')
                    .swiper-slide
                        img(src='img/slide-10.jpg')
                    .swiper-slide
                        img(src='img/slide-11.jpg')
                    .swiper-slide
                        img(src='img/slide-12.jpg')
                    .swiper-slide
                        img(src='img/slide-13.jpg')
                    .swiper-slide
                        img(src='img/slide-14.jpg')
            .swiper-button-next
                img(src="img/prev.svg" alt="prev")


            .cart__content-options