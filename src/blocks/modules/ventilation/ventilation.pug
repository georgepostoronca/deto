.ventilation(data-aos)
    .container
        //img(class="ventilation__wave" role="presentation" src="img/ventilation-top-wave.png" alt="image wave in ventilation block")

        .ventilation__wrap
            p.ventilation__desc.text Вентиляция позволяет избежать образования излишней влаги во время ванных процедур
            //img(src="img/ventilation-bg.svg" alt="ventilation image")
            include ./ventilation-bg
            p.ventilation__desc-bottom.text.text--upercase.text--bold(data-aos="fade-up") ЦЕЛЬНОЛИТОЙ ЛАТУННЫЙ СМЕСИТЕЛЬ С РЕЗЬБОВЫМИ СОЕДИНЕНИЯМИ И КАРТРИДЖАМИ ИЗ КЕРАМИКИ


        .ventilation__bottom
            img(class="ventilation__wave-bottom" loading="lazy" role="presentation" src="img/ventilation-wave-bottom.png" alt="image wave bottom in ventilation block")

            ul
                li(data-aos="fade-right")
                    +svg("clock")
                    span Длительный срок службы до 15 лет
                li(data-aos="fade-right" data-aos-duration="500")
                    +svg("celsius")
                    span Стойкость к перепадам температур
                li(data-aos="fade-right" data-aos-duration="100")
                    +svg("wawe")
                    span Устойчивость к коррозии и ржавчине

            .ventilation__bottom-images
                img(class="first" <img loading="lazy" src="https://via.placeholder.com/320x200" alt="Lazy loaded image" /> src="img/ventilation-image-1.png" alt="shower hose" data-aos="fade-right")
                img(class="second" <img loading="lazy" src="https://via.placeholder.com/320x200" alt="Lazy loaded image" /> src="img/ventilation-image-2.png" alt="shower head" data-aos="fade-right" data-aos-duration="500")



