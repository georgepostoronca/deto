.shower-head
    .container
        .shower-head__wrap
            h2.h1(data-aos="fade-up") ЛЕЙКА ДУША С ТЕХНОЛОГИЕЙ EASY CLEAN

            .shower-head__grid(data-aos="fade-up" data-aos-duration="500")
                .shower-head__line
                .shower-head__first
                    img(loading="lazy" src="img/shower-head-img-1.png" alt="first image")
                    h4 Зеркальный блеск на долгие годы
                    p За лейкой душа с технологией Easy Clean ухаживать очень просто: мягкие силиконовые форсунки мгновенно очищаются от загрязнений и известкового налета – достаточно провести по ним пальцем

                .shower-head__second
                    img(loading="lazy" src="img/shower-head-img-2.png" alt="second image")
                    h4 Легкая очистка от известкового налета
                    p Специальное покрытие аксессуаров душевой кабины L790 устойчиво к коррозии, появлению сколов и потускнению. На протяжении многих лет они будут выглядеть как новые