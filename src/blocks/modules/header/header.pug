header.header
    .container
        .header__wrap
            h1.mobile.text-center ДУШЕВАЯ КАБИНА DETO L790

            //Image
            .header__img
                .header__img-inner.js-header-opened
                    img(src="img/shower.png" class="closed" alt="душ")
                    img(src="img/shower-opened.png" class="opened" alt="открытый душ")
                    span.js-scroll-to 90x90
                    em 33 900 ₽

            //Content
            .header__content
                h1.desktop.text-center ДУШЕВАЯ КАБИНА DETO L790

                .header__grid
                    .item.js-header-item
                        .item__svg.flare
                            +svg("settings")
                        .item__content
                            h5 Easy Fix
                            p Супер легкая сборка

                    .item.js-header-item
                        .item__svg.flare
                            +svg("refresh")
                        .item__content
                            h5 Click-Clack
                            p Удобная эксплуатация

                    .item.js-header-item
                        .item__svg.flare
                            +svg("clean")
                        .item__content
                            h5 Easy Clean
                            p Легкий и простой уход за кабиной

                    .item.js-header-item
                        .item__svg.flare
                            +svg("silicon-free")
                        .item__content
                            h5 Silikon Free
                            p Сборка без использования силикона

                    .item.js-header-item
                        .item__svg.flare
                            +svg("tempered-glass")
                        .item__content
                            h5 Тempered glass
                            p Безопасное закаленное стекло

                button
                    span КУПИТЬ