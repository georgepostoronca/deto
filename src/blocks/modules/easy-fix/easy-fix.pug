.easy-fix
    .container
        .easy-fix__wrap
            h2.h1(data-aos="fade-up") ЛЕГКАЯ СБОРКА

            ul
                li(data-aos="fade-up")
                    +svg("silikon")
                    h4 Silikon Free
                    span Cборка без силикона

                li(data-aos="fade-up" data-aos-duration="1000")
                    +svg("fix")
                    h4 Easy Fix
                    span Безупречная подгонка деталей

                li(data-aos="fade-up" data-aos-duration="1500")
                    +svg("cup")
                    h4 Лидер на рынке по легкости сборки!

                li(data-aos="fade-up" data-aos-duration="2000")
                    +svg("medal")
                    h4 Гарантия 5 лет